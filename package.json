{
  "name": "obsidian-claude-cortex",
  "version": "1.3.20",
  "description": "Cortex - Claude Code embedded in Obsidian sidebar",
  "main": "main.js",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "dev": "pnpm run build:css && node esbuild.config.mjs",
    "build": "pnpm run build:css && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "node scripts/sync-version.js && git add manifest.json",
    "deploy": "source .env && ./scripts/deploy.sh"
  },
  "keywords": [
    "obsidian",
    "claude",
    "ai",
    "agent",
    "cortex"
  ],
  "author": "Shravan Sunder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShravanSunder/obsidian-claude-cortex.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^25.0.9",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.27.1",
    "obsidian": "latest",
    "typescript": "^5.0.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.12",
    "mermaid": "^11.12.2",
    "tslib": "^2.8.1"
  }
}
